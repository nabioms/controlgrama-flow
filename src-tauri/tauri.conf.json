{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ControlGrama",
  "version": "1.0.1",
  "identifier": "br.com.controlgrama.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "ControlGrama",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "category": "Business",
    "shortDescription": "Gestão de serviços, equipes, diárias e financeiro",
    "longDescription": "ControlGrama — gestão de serviços, equipes, diárias, ordens de serviço e financeiro."
  }
}